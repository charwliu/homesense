+            (false, false, StatusCode::UNAUTHORIZED),
+            (true, false, StatusCode::OK),
+            (true, true, StatusCode::SERVICE_UNAVAILABLE),
+        ] {
+            *controller.write().unwrap() = authenticated.then_some(id);
+            unavailable.store(fail, Ordering::SeqCst);
+            let response = handler
+                .handle(
+                    Uri::from_static("/accessories"),
+                    Body::empty(),
+                    controller.clone(),
+                    subscriptions.clone(),
+                    config.clone(),
+                    storage.clone(),
+                    db.clone(),
+                    emitter.clone(),
+                )
+                .await;
+            if !authenticated {
+                assert!(matches!(
+                    response,
+                    Err(Error::HttpStatus(StatusCode::UNAUTHORIZED))
+                ));
+                assert_eq!(reads.load(Ordering::SeqCst), 0);
+                continue;
+            }
+            let response = response.unwrap();
+            assert_eq!(response.status(), status);
+            let json: serde_json::Value =
+                serde_json::from_slice(&hyper::body::to_bytes(response.into_body()).await.unwrap())
+                    .unwrap();
+            if fail {
+                assert_eq!(json, serde_json::json!({"status":-70402}));
+            } else {
+                let characteristic = json["accessories"][0]["services"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .flat_map(|s| s["characteristics"].as_array().unwrap())
+                    .find(|c| c["iid"] == iid)
+                    .unwrap();
+                assert_eq!(characteristic["value"], 73);
+            }
+        }
+        assert_eq!(writes.load(Ordering::SeqCst), 0);
+        let mut reader = super::super::characteristics::GetCharacteristics::new();
+        let response = reader
+            .handle(
+                "/characteristics?id=999.1".parse().unwrap(),
+                Body::empty(),
+                controller.clone(),
+                subscriptions.clone(),
+                config.clone(),
+                storage.clone(),
+                db.clone(),
+                emitter.clone(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(response.status(), StatusCode::MULTI_STATUS);
+        let json: serde_json::Value =
+            serde_json::from_slice(&hyper::body::to_bytes(response.into_body()).await.unwrap())
+                .unwrap();
+        assert_eq!(json["characteristics"][0]["status"], -70409);
+        storage.lock().await.delete_pairing(&id).await.unwrap();
+        assert!(matches!(
+            handler
+                .handle(
+                    Uri::from_static("/accessories"),
+                    Body::empty(),
+                    controller.clone(),
+                    subscriptions.clone(),
+                    config.clone(),
+                    storage.clone(),
+                    db.clone(),
+                    emitter.clone()
+                )
+                .await,
+            Err(Error::HttpStatus(StatusCode::UNAUTHORIZED))
+        ));
+        assert!(matches!(
+            reader
+                .handle(
+                    "/characteristics?id=2.1".parse().unwrap(),
+                    Body::empty(),
+                    controller,
+                    subscriptions,
+                    config,
+                    storage,
+                    db,
+                    emitter
+                )
+                .await,
+            Err(Error::HttpStatus(StatusCode::UNAUTHORIZED))
+        ));
+        assert_eq!(writes.load(Ordering::SeqCst), 0);
+        std::fs::remove_dir_all(path).unwrap();
+    }
+}
